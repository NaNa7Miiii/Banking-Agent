{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlannerOutput",
  "description": "Execution plan produced by the planner (planning only, no execution).",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal", "intent_summary", "steps", "next_step_id"],
  "properties": {
    "goal": { "type": "string" },
    "intent_summary": { "type": "string" },

    "assumptions": { "type": "array", "items": { "type": "string" }, "default": [] },
    "constraints": { "type": "array", "items": { "type": "string" }, "default": [] },

    "subagent_directory": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "when_to_use"],
        "properties": {
          "name": { "type": "string" },
          "when_to_use": { "type": "string" }
        }
      }
    },

    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "owner", "depends_on", "actions", "expected_outputs", "acceptance_criteria", "status"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "instruction": {
            "type": "string",
            "description": "Single clear task sentence for the executor (e.g. 'Find the user\\'s transactions in the last 30 days'). Required for steps that will be executed by a subagent."
          },

          "owner": {
            "type": "string",
            "pattern": "^(main|react_executor|subagent:[a-z0-9_\\-]+|tool:[a-z0-9_\\-]+)$"
          },

          "depends_on": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["step_id", "type"],
              "properties": {
                "step_id": { "type": "string" },
                "type": { "type": "string", "enum": ["hard", "soft", "resource"] },
                "note": { "type": "string" }
              }
            }
          },

          "inputs_needed": { "type": "array", "items": { "type": "string" }, "default": [] },
          "actions": { "type": "array", "items": { "type": "string" } },
          "expected_outputs": { "type": "array", "items": { "type": "string" } },
          "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
          "fallback": { "type": "array", "items": { "type": "string" }, "default": [] },

          "parallel_group": { "type": ["string", "null"], "default": null },

          "write_scope": {
            "type": ["object", "null"],
            "default": null,
            "additionalProperties": false,
            "required": ["mode", "paths"],
            "properties": {
              "mode": { "type": "string", "enum": ["read", "write", "mixed", "none"] },
              "paths": { "type": "array", "items": { "type": "string" }, "default": [] }
            }
          },

          "status": { "type": "string", "enum": ["todo", "done", "skipped"] }
        }
      }
    },

    "next_step_id": { "type": ["string", "null"] },

    "join_points": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["after_parallel_group", "merge_artifacts_from_steps", "into"],
        "properties": {
          "after_parallel_group": { "type": "string" },
          "merge_artifacts_from_steps": { "type": "array", "items": { "type": "string" } },
          "into": { "type": "string", "description": "Step id that consumes merged artifacts OR a named output bucket." },
          "merge_strategy": {
            "type": "string",
            "enum": ["union", "prefer_latest", "manual_review", "llm_refine"],
            "default": "union"
          }
        }
      }
    }
  }
}
