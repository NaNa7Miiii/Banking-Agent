# ---------- Banking Agent · environment template ----------
# Copy to `.env` for local dev (`cp .env.example .env`) or paste values into
# Railway → Variables for production. NEVER commit the real `.env`.

# === LLM (required) ===
OPENAI_API_KEY=sk-...

# === Database (required — AWS RDS Postgres) ===
DB_HOST=xxx.xxx.rds.amazonaws.com
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_DATABASE=customer_transaction_db
DB_TABLE_NAME=transactions

# === Vector DB / RAG (required for RAG agent) ===
PINECONE_API_KEY=pcsk-...
PINECONE_INDEX_NAME=cibc-docs-hybrid
RAG_DEFAULT_NAMESPACE=cibc-en

# === Web search (optional — RAG fallback) ===
TAVILY_API_KEY=

# === Conversation memory (optional — requires Redis) ===
# Railway "New → Database → Redis" injects REDIS_URL automatically.
# Current code reads REDIS_HOST/REDIS_PORT; if you add Redis on Railway, split
# REDIS_URL into host/port or update utils/memory.py to read REDIS_URL directly.
REDIS_HOST=
REDIS_PORT=

# === Observability (optional — Langfuse cloud) ===
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# === Runtime tuning (optional) ===
MAX_CONCURRENT_STEPS=4
SQL_DEFAULT_LIMIT=200
SQL_MAX_ROWS=1000
LOG_LEVEL=INFO

# === Server ===
# Railway injects PORT automatically. Only override for local dev.
# PORT=8000
